# ── AI API ───────────────────────────────────────────────────
# OpenAI API 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# ── Flask 서버 ────────────────────────────────────────────────
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0
FLASK_SECRET=change-this-to-a-random-secret-key

# ── 관리자 계정 ───────────────────────────────────────────────
ADMIN_ID=admin
ADMIN_PW=your-admin-password-here

# ── DB 경로 (기본값: 프로젝트 루트) ──────────────────────────
MARKET_DB=market_watchdog.db
